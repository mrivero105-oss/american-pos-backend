<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scanner_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true">

    <androidx.camera.view.PreviewView
        android:id="@+id/scanner_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="compatible"
        app:scaleType="fillCenter" />

    <!-- Retícula central de apuntamiento -->
    <FrameLayout
        android:layout_width="290dp"
        android:layout_height="170dp"
        android:layout_gravity="center"
        android:background="@drawable/scanner_reticle_border">

        <View
            android:id="@+id/scanner_laser_line"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="center"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="#34D399" />
    </FrameLayout>

    <!-- Barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#B3020617"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/scanner_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Escáner Nativo POS"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/scanner_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Apunta al código • Toca pantalla para enfocar"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <TextView
            android:id="@+id/scanner_burst_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/scanner_pill_bg"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="RÁFAGA (0)"
            android:textColor="#34D399"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:ignore="HardcodedText" />

        <Button
            android:id="@+id/scanner_btn_close"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:background="@drawable/scanner_pill_bg"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <!-- Panel inferior con último código y acciones táctiles -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC020617"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/scanner_last_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/scanner_pill_bg"
            android:gravity="center"
            android:padding="10dp"
            android:textColor="#34D399"
            android:textSize="14sp"
            android:textStyle="bold"
            android:typeface="monospace"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/scanner_btn_torch"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/scanner_pill_bg"
                android:text="Luz"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText,ButtonStyle" />

            <Button
                android:id="@+id/scanner_btn_burst"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1.2"
                android:background="@drawable/scanner_pill_bg"
                android:text="Ráfaga +1"
                android:textAllCaps="false"
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText,ButtonStyle" />

            <Button
                android:id="@+id/scanner_btn_manual"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1.2"
                android:background="@drawable/scanner_pill_bg"
                android:text="Manual/OCR"
                android:textAllCaps="false"
                android:textColor="#93C5FD"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText,ButtonStyle" />

            <Button
                android:id="@+id/scanner_btn_done"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/scanner_reticle_border"
                android:text="Listo"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText,ButtonStyle" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
