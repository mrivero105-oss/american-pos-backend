{
  "name": "isaac-pos",
  "version": "24.4.0",
  "author": {
    "name": "Isaac POS Team",
    "email": "support@isaacpos.com"
  },
  "description": "Sistema de Punto de Venta Isaac POS V24.04",
  "main": "main.js",
  "scripts": {
    "start": "node index.js",
    "electron:start": "electron .",
    "pack": "electron-builder --config electron-builder.legacy.json --dir",
    "pack:legacy": "electron-builder --config electron-builder.legacy.json --dir",
    "pack:modern": "electron-builder --config electron-builder.modern.json --dir",
    "dist": "electron-builder --config electron-builder.legacy.json",
    "dist:legacy": "electron-builder --config electron-builder.legacy.json",
    "dist:legacy32": "electron-builder --config electron-builder.legacy.json --win nsis --ia32",
    "dist:modern": "electron-builder --config electron-builder.modern.json",
    "test:stress": "node test_stress_offline_sync.js",
    "test:math": "node test_vortex_engine.js",
    "test:zerotrust": "node test_zero_trust_sale.js",
    "test:cache": "node test_auth_cache_latency.js",
    "test": "node --test tests/pos-integrity.test.mjs",
    "test:e2e": "node --test tests/test_e2e_api_and_socket.test.mjs",
    "test:all": "node scripts/run_all_tests.cjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^10.6.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.4",
    "whatsapp-web.js": "^1.34.8",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/rebuild": "^4.0.2",
    "electron": "22.3.27",
    "electron-builder": "^26.18.0",
    "googleapis": "^171.4.0"
  },
  "build": {
    "appId": "com.isaacpos.frontend",
    "productName": "Isaac POS",
    "compression": "normal",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "**/node_modules/**/*.node",
      "**/bin/**/*"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "instalar_postgresql.ps1",
          "harden_windows_security.ps1"
        ]
      }
    ],
    "directories": {
      "output": "dist_final_installer"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mrivero105-oss",
        "repo": "american-pos-backend"
      }
    ],
    "files": [
      "**/*",
      "!scripts/**",
      "!private/**",
      "!audit_*.json",
      "!coverage/**",
      "!test-results/**",
      "!playwright-report/**",
      "!**/*.zip",
      "!**/*.tar.gz",
      "!**/*.sqlite",
      "!**/*.sqlite*",
      "!**/*.bak",
      "!**/*.dev_backup",
      "!**/serviceAccountKey.json",
      "!**/.env*",
      "!**/.dbcfg.key.dpapi",
      "!**/.dbcfg.key.dpapi.ess",
      "!**/.secrets.key.dpapi",
      "!**/.secrets.key.dpapi.ess",
      "!**/*.dpapi.ess",
      "!**/secrets.vault.json",
      "!**/*.vault.json",
      "!env_backup.txt",
      "!app_fixed.asar",
      "!test_backup.zip",
      "!.wwebjs_auth/**",
      "!.wwebjs_cache/**",
      "!.test_wwebjs_auth/**",
      "!dist*/**",
      "!backups/**",
      "!build_temp/**",
      "!auto-backups/**",
      "!scratch/**",
      "!uploads/**",
      "!product_images/**",
      "!supplier_logos/**",
      "!invoices/**",
      "!logs/**",
      "!**/*.log",
      "!**/*.log.gz",
      "!db.json",
      "!.git/**",
      "!**/*.md",
      "!LICENSE",
      "!*.ps1",
      "!public/*.exe",
      "!public/*.apk",
      "!public/*.zip",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/@electron/rebuild/**",
      "!node_modules/builder-util/**",
      "!node_modules/typescript/**",
      "!node_modules/**/*.map",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.d.mts",
      "!node_modules/**/*.d.cts",
      "!tests/**",
      "!*.apk",
      "!**/*.apk",
      "!test_*.js",
      "!check_*.js",
      "!fix_*.js",
      "!inspect_*.js",
      "!find_*.js",
      "!scratch*.js",
      "!*.bat",
      "!tailwind.config.js",
      "!backup_debug.log",
      "!build/cert.pfx",
      "!**/*.pfx",
      "!**/*.p12",
      "!**/*.key",
      "!**/keys/*private*",
      "!**/*private*.pem",
      "!settings.json",
      "!db-config.json",
      "!cloud_mirror_config.json",
      "!cloud_license_config.json",
      "!**/cloud_license_config.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "3_IsaacPOS_Windows7_8_8.1_Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Isaac POS",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "3_IsaacPOS_Windows7_8_8.1_Setup.${ext}",
      "include": "build/installer.nsh"
    }
  }
}
