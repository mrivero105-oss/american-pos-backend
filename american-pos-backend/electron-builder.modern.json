{
  "appId": "com.isaacpos.frontend",
  "productName": "Isaac POS",
  "electronVersion": "31.4.0",
  "compression": "normal",
  "npmRebuild": false,
  "asar": true,
  "asarUnpack": [
    "**/node_modules/**/*.node",
    "**/bin/**/*"
  ],
  "extraResources": [
    {
      "from": "scripts",
      "to": "scripts"
    }
  ],
  "publish": [
    {
      "provider": "github",
      "owner": "mrivero105-oss",
      "repo": "american-pos-backend",
      "channel": "modern"
    }
  ],
  "directories": {
    "output": "dist_modern"
  },
  "files": [
    "**/*",
    "!scripts/**",
    "!private/**",
    "!audit_*.json",
    "!coverage/**",
    "!**/*.zip",
    "!**/*.tar.gz",
    "!**/*.sqlite",
    "!**/*.sqlite*",
    "!**/*.bak",
    "!**/*.dev_backup",
    "!**/serviceAccountKey.json",
    "!**/.env*",
    "!**/.dbcfg.key.dpapi",
    "!**/.dbcfg.key.dpapi.ess",
    "!**/.secrets.key.dpapi",
    "!**/.secrets.key.dpapi.ess",
    "!**/*.dpapi.ess",
    "!**/secrets.vault.json",
    "!**/*.vault.json",
    "!env_backup.txt",
    "!app_fixed.asar",
    "!test_backup.zip",
    "!.wwebjs_auth/**",
    "!.wwebjs_cache/**",
    "!.test_wwebjs_auth/**",
    "!dist*/**",
    "!backups/**",
    "!build_temp/**",
    "!auto-backups/**",
    "!scratch/**",
    "!uploads/**",
    "!product_images/**",
    "!supplier_logos/**",
    "!invoices/**",
    "!logs/**",
    "!**/*.log",
    "!**/*.log.gz",
    "!db.json",
    "!db-config.json",
    "!settings.json",
    "!cloud_mirror_config.json",
    "!cloud_license_config.json",
    "!**/cloud_license_config.json",
    "!.git/**",
    "!**/*.md",
    "!LICENSE",
    "!*.ps1",
    "!public/*.exe",
    "!public/*.apk",
    "!public/*.zip",
    "!node_modules/electron/**",
    "!node_modules/electron-builder/**",
    "!node_modules/@electron/rebuild/**",
    "!node_modules/builder-util/**",
    "!node_modules/typescript/**",
    "!node_modules/**/*.map",
    "!node_modules/**/*.d.ts",
    "!node_modules/**/*.d.mts",
    "!node_modules/**/*.d.cts",
    "!tests/**",
    "!test-results/**",
    "!playwright-report/**",
    "!*.apk",
    "!**/*.apk",
    "!test_*.js",
    "!check_*.js",
    "!fix_*.js",
    "!inspect_*.js",
    "!find_*.js",
    "!scratch*.js",
    "!*.bat",
    "!tailwind.config.js",
    "!backup_debug.log",
    "!build/cert.pfx",
    "!**/*.pfx",
    "!**/*.p12",
    "!**/*.key",
    "!**/keys/*private*",
    "!**/*private*.pem"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "build/icon.ico",
    "requestedExecutionLevel": "highestAvailable",
    "artifactName": "4_IsaacPOS_Windows10_11_Modern_Setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "shortcutName": "Isaac POS Modern",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "artifactName": "4_IsaacPOS_Windows10_11_Modern_Setup.${ext}",
    "include": "build/installer_modern.nsh"
  }
}