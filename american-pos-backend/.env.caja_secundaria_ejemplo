# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN PARA CAJAS SECUNDARIAS (CAJA 2, CAJA 3, TERMINALES)
# ==============================================================================
# Copia este contenido al archivo .env de la PC secundaria que actuará como caja adicional.
# Reemplaza los valores marcados con <...> usando los del Servidor Principal (%APPDATA%\isaac-pos\.env).
# ==============================================================================

NODE_ENV=production
PORT=3005

# Modo de Base de Datos
DB_DIALECT=postgres

# Conexión al Servidor Central (Caja 1 / Servidor)
DB_HOST=192.168.1.3
DB_PORT=5432
DB_NAME=americanpos
DB_USER=postgres
DB_PASSWORD=<DEFINIR_PASSWORD_POSTGRES>

# Secretos criptográficos (sincronizar únicamente en entorno seguro con Caja Principal)
JWT_SECRET=<COPIAR_JWT_SECRET_DESDE_CAJA_PRINCIPAL>
SYNC_SECRET_KEY=<COPIAR_SYNC_SECRET_KEY_DESDE_CAJA_PRINCIPAL>
INITIAL_ADMIN_PASSWORD=<DEFINIR_PASSWORD_INICIAL_SEGURO>
