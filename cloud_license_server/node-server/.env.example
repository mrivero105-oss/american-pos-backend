# Puerto HTTP donde escucha el servidor Gateway
PORT=8787

# Ruta a tu llave privada RSA-2048 o contenido PEM completo (en una línea con \n o ruta de archivo)
LICENSE_PRIVATE_KEY_FILE=C:\Users\mrive\IsaacPOS-Llaves-Privadas\private.pem
# LICENSE_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Credenciales del proveedor para entrar desde la pestaña "Control en Línea (Proveedor)"
ADMIN_EMAIL=proveedor@tudominio.com
# Recomendado en producción: hash scrypt o sha256; en desarrollo o test puedes definir ADMIN_PASSWORD
ADMIN_PASSWORD=CambiaEstaClaveSegura123!
ADMIN_JWT_SECRET=genera-un-secreto-largo-aleatorio-de-64-caracteres
# Opcional: token estático alternativo para scripts/header x-admin-secret
ADMIN_API_SECRET=

# Base de datos PostgreSQL opcional (si se deja vacío, usa almacenamiento JSON local en ./data/licenses.db.json)
# DATABASE_URL=postgres://usuario:password@host:5432/postgres
# JSON_STORE_PATH=./data/licenses.db.json

# Políticas por defecto
DEFAULT_GRACE_DAYS=7
AUTO_REGISTER_ACTIVE=true
